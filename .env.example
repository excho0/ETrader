# Optional docker compose overrides for the ETrader stack.

COMPOSE_PROJECT_NAME=etrader

IB_GATEWAY_ENV_FILE=./ib-gateway.env
IB_GATEWAY_DATA_DIR=./data/ib-gateway/tws_settings
IB_GATEWAY_SETTINGS_PATH=/home/ibgateway/tws_settings
IB_TWS_ENV_FILE=./ib-tws.env
IB_TWS_DATA_DIR=./data/ib-tws
IB_TWS_SETTINGS_PATH=/config/tws_settings
IB_BRIDGE_ENV_FILE=./apps/ib-bridge/.env
IB_BRIDGE_DATA_DIR=./data/ib-bridge
IB_TWS_HOST=docker.host.internal
IB_TWS_PAPER_PORT=7497
IB_TWS_LIVE_PORT=7496
MCP_HTTP_ISSUER_URL=http://localhost:8040
MCP_HTTP_RESOURCE_SERVER_URL=http://localhost:8040
