# ETrader IB Bridge example environment
# Copy this file to a local untracked .env and replace the placeholder values.

ENV=dev
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8040

IB_TARGET_MODE=auto
IB_PREFERRED_MODE=paper
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PAPER_PORT=4002
IB_GATEWAY_LIVE_PORT=4001
# For Dockerized MCP-only usage against a host workstation, use docker.host.internal.
IB_TWS_HOST=docker.host.internal
IB_TWS_PAPER_PORT=7497
IB_TWS_LIVE_PORT=7496
IB_CLIENT_ID=11
IB_READ_ONLY=true
IB_CONNECT_TIMEOUT_SECONDS=10
IB_REQUEST_TIMEOUT_SECONDS=30
IB_AUTO_RECONNECT=true
IB_RECONNECT_INTERVAL_SECONDS=5
IB_RECONNECT_BACKOFF_MAX_SECONDS=60

AUTO_CONNECT_ON_STARTUP=true
ALLOW_PAPER_ORDERS=false
ALLOW_LIVE_ORDERS=false
MAX_ORDER_QUANTITY=1000
RISK_MAX_TRADE_NOTIONAL=25000
RISK_MAX_POSITION_NOTIONAL=50000
RISK_MAX_SYMBOL_CONCENTRATION_PCT=5
RISK_MAX_DAILY_NEW_EXPOSURE=100000
RISK_MAX_OPEN_ORDERS_PER_SYMBOL=4
RISK_BLOCK_DELAYED_MARKET_ORDERS=true
RISK_MAX_MARKET_SPREAD_BPS=50
RISK_REQUIRE_LIMIT_FOR_WIDE_SPREAD=true
RISK_WIDE_SPREAD_BPS=10
RISK_LIVE_TRADE_NOTIONAL=10000
RISK_LIVE_POSITION_NOTIONAL=25000
RISK_LIVE_SYMBOL_CONCENTRATION_PCT=2.5
RISK_LIVE_DAILY_NEW_EXPOSURE=25000
RISK_LIVE_MAX_OPEN_ORDERS_PER_SYMBOL=2
RISK_LIVE_REQUIRE_APPROVAL=true
RISK_PAPER_APPROVAL_TRADE_NOTIONAL=15000
RISK_LIVE_APPROVAL_TRADE_NOTIONAL=5000
APPROVAL_TTL_SECONDS=900
DATA_DIR=./data/ib-bridge
# Optional explicit overrides if you do not want the default mode-based files:
# DATABASE_PATH_PAPER=/path/to/trading-paper.sqlite3
# DATABASE_PATH_LIVE=/path/to/trading-live.sqlite3

AUTH_ENABLED=true
AUTH_AGENT_TOKEN=change-me-agent-token
AUTH_EXECUTE_TOKEN=change-me-execute-token
MCP_HTTP_LOCALHOST_AUTH_BYPASS=true
MCP_HTTP_LOCALHOST_BYPASS_SCOPE=execute

MCP_STDIO_AUTH_BYPASS=true
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8040
MCP_HTTP_ISSUER_URL=http://localhost:8040
MCP_HTTP_RESOURCE_SERVER_URL=http://localhost:8040
